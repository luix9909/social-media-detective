{
  "name": "social-media-detective",
  "version": "1.0.0",
  "description": "Gather public information about social media accounts across multiple platforms",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "server": "nodemon server.js",
    "test": "jest --coverage",
    "lint": "eslint .",
    "docker:build": "docker build -t social-media-detective .",
    "docker:run": "docker run -p 5000:5000 social-media-detective"
  },
  "keywords": [
    "social-media",
    "detective",
    "scraping",
    "osint"
  ],
  "author": "luix9909",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "i18next": "^23.7.6",
    "i18next-node-fs-backend": "^2.1.3",
    "lodash": "^4.17.21",
    "mongoose": "^8.0.0",
    "node-cache": "^5.1.2",
    "playwright": "^1.40.0",
    "rate-limit": "^1.1.3",
    "redis": "^4.6.11"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
